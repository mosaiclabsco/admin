# Supabase do portal admin (projeto próprio, separado das plataformas)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Apenas no servidor; nunca usar prefixo NEXT_PUBLIC_ nestas chaves.
SUPABASE_SECRET_KEY=sb_secret_...

# Envio do código de login e respostas de suporte
RESEND_API_KEY=re_...
EMAIL_FROM=Mosaic Labs Admin <admin-noreply@mosaic-labs.co>
# Segredo do webhook "email.received" do Resend (whsec_...)
RESEND_WEBHOOK_SECRET=
# Chave separada com Full access para ler o corpo dos emails recebidos.
RESEND_RECEIVING_API_KEY=
SUPPORT_RECEIVING_DOMAIN=support.mosaic-labs.co
# Opcional: remetente verificado para respostas (Reply-To usa a caixa de suporte).
SUPPORT_EMAIL_FROM=

# Cron de health check (Authorization: Bearer <CRON_SECRET>). Gerar: openssl rand -hex 32
CRON_SECRET=
# Sessão administrativa: limite absoluto de 12 horas, também aplicado no banco.

# Integração Lessonara: leitura de contas e RPC administrativa restrita, somente no servidor.
LESSONARA_SUPABASE_URL=
LESSONARA_SUPABASE_SECRET_KEY=
