{
  "name": "mosaic-labs-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "node --version && next build",
    "start": "next start --port 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "db:start": "node scripts/start-local-db.mjs",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "admin:add": "node --env-file=.env.local scripts/add-admin.mts",
    "test:db": "DB_INTEGRATION=1 node --env-file=.env.local node_modules/vitest/vitest.mjs run test/"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.32.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.29",
    "supabase": "^2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.x"
  }
}
